{
  "schema_version": "2.0",
  "map_id": "codex-role-map-task-state-20260529",
  "source_of_truth": {
    "role_semantics": "agents/*.md",
    "role_to_agent_type_map": "agents/codex-role-map.json",
    "control_plane": "docs/ai/tasks/<task_id>/state.json",
    "allowed_agent_types": ["default", "explorer", "worker"]
  },
  "selection_order": [
    "select_role",
    "resolve_role_map",
    "load_task_state",
    "resolve_subtask_assignment"
  ],
  "roles": {
    "planner": {
      "agent_type": "default",
      "model": "gpt-5",
      "reasoning_effort": "high",
      "allow_write": true,
      "allow_shell": true,
      "notes": "用于方案冻结、边界收敛、subtask 拆解与 state.json 维护。"
    },
    "reader": {
      "agent_type": "explorer",
      "model": "gpt-5",
      "reasoning_effort": "medium",
      "allow_write": false,
      "allow_shell": true,
      "notes": "只读补上下文与证据，不允许写入目标文件。"
    },
    "reviewer": {
      "agent_type": "default",
      "model": "gpt-5",
      "reasoning_effort": "high",
      "allow_write": false,
      "allow_shell": true,
      "notes": "基于 task_state + subtask 做审查，以 findings 为主。"
    },
    "backend-implementer": {
      "agent_type": "worker",
      "model": "gpt-5",
      "reasoning_effort": "medium",
      "allow_write": true,
      "allow_shell": true,
      "notes": "后端逻辑、脚本和服务端实现。"
    },
    "frontend-implementer": {
      "agent_type": "worker",
      "model": "gpt-5",
      "reasoning_effort": "medium",
      "allow_write": true,
      "allow_shell": true,
      "notes": "前端页面、样式和交互实现。"
    },
    "test-verifier": {
      "agent_type": "worker",
      "model": "gpt-5",
      "reasoning_effort": "high",
      "allow_write": true,
      "allow_shell": true,
      "notes": "补测、执行验证并把验收结果写回 subtask.result。"
    },
    "doc-curator": {
      "agent_type": "worker",
      "model": "gpt-5",
      "reasoning_effort": "medium",
      "allow_write": true,
      "allow_shell": false,
      "notes": "文档整理、规范收敛与入口同步。"
    },
    "ops-runbook": {
      "agent_type": "worker",
      "model": "gpt-5",
      "reasoning_effort": "medium",
      "allow_write": true,
      "allow_shell": true,
      "notes": "运维手册、排障说明和运行验证。"
    }
  }
}
