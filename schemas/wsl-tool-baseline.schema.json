{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WSL tool baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "packages"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "source", "command"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "source": {"enum": ["apt", "external"]},
                "command": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "probe": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "doctor": {"type": "boolean"},
                "doctor_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
