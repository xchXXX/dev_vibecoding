{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DispatchPacket",
  "description": "复杂任务施工图对象，补充逐文件改法、执行顺序、不变量与回退策略。",
  "type": "object",
  "required": [
    "dispatch_packet_id",
    "work_order_id",
    "instruction_source",
    "change_spec",
    "execution_order",
    "read_before_write",
    "invariants",
    "forbidden_changes",
    "dependency_notes",
    "done_signals",
    "verification_focus",
    "fallback_strategy",
    "handoff_notes"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "dispatch_packet_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "与 work_order.role 对齐的角色标识，用于明确施工包的执行主体。"
    },
    "write_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "兼容字段：与 work_order.write_paths 对齐的最终可写路径。"
    },
    "write_scope": {
      "type": "object",
      "description": "与 work_order.write_scope 对齐的写入边界语义。",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "allowlist",
            "readonly"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "relationship_to_write_paths": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "return_packet_path": {
      "type": "string"
    },
    "return_packet_required": {
      "type": "boolean"
    },
    "required_return_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion_gate": {
      "type": "string"
    },
    "state_owner": {
      "type": "string"
    },
    "instruction_source": {
      "type": "string"
    },
    "change_spec": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "change_type",
          "instructions"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "change_type": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete",
              "refactor",
              "verify_only"
            ]
          },
          "instructions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "done_when": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "execution_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "read_before_write": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dependency_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "done_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification_focus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "fallback_strategy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "handoff_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "execution_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
