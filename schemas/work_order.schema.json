{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkOrder",
  "description": "执行型委派合同对象，描述角色、边界、回收字段与完成闸门。",
  "type": "object",
  "required": [
    "work_order_id",
    "plan_id",
    "role",
    "task_goal",
    "scope_in",
    "scope_out",
    "read_paths_mandatory",
    "read_paths_optional",
    "write_paths",
    "context_paths",
    "evidence_summary",
    "constraints",
    "change_spec",
    "execution_steps",
    "verification_steps",
    "acceptance_criteria",
    "stop_conditions",
    "dispatch_message_raw",
    "return_packet_path",
    "return_packet_required",
    "required_return_fields",
    "completion_gate",
    "state_owner"
  ],
  "properties": {
    "work_order_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "业务角色标识（例如 reader、reviewer、backend-implementer），由角色层委派语义决定。"
    },
    "task_goal": {
      "type": "string"
    },
    "scope_in": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope_out": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "read_paths_mandatory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "read_paths_optional": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "向后兼容字段：最终允许写入的路径白名单。"
    },
    "write_scope": {
      "type": "object",
      "description": "角色委派写入边界定义；用于解释 write_paths 的来源与策略，不替代 write_paths。",
      "required": [
        "policy",
        "paths"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "allowlist",
            "readonly"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "relationship_to_write_paths": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "context_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "must_follow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_spec": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "instructions"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "instructions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "done_when": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "execution_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "instruction_source": {
      "type": "string"
    },
    "dispatch_packet_path": {
      "type": "string"
    },
    "return_packet_path": {
      "type": "string"
    },
    "return_packet_required": {
      "type": "boolean"
    },
    "required_return_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "completion_gate": {
      "type": "string"
    },
    "state_owner": {
      "type": "string"
    },
    "dispatch_message_raw": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
