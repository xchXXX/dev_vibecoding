{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "type": "object",
  "required": [
    "plan_id",
    "task_id",
    "status",
    "source_plan_doc",
    "goal",
    "scope_in",
    "scope_out",
    "acceptance",
    "stop_conditions"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "mode": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "plan_owner": {
      "type": "string"
    },
    "source_plan_doc": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "scope_in": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase_overview": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan_md_is_semantic_source": {
      "type": "boolean"
    },
    "plan_json_is_structured_projection": {
      "type": "boolean"
    },
    "goal_legacy": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
